    "openai": "^6.27.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.30",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.5.4"
  }
}
