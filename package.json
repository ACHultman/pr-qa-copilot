{
  "name": "pr-qa-copilot",
  "version": "0.2.0",
  "private": true,
  "description": "GitHub Action: critical journeys, runtime QA, changed-route checks, screenshots, and visual diffs",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --test",
    "build": "ncc build src/run.js -o dist --source-map",
